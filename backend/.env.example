# LEARN Project Environment Variables
# CRITICAL: Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# Flask Security Configuration (REQUIRED)
# Generate secure random keys using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-generate-a-random-hex-string
SECURITY_PASSWORD_SALT=your-password-salt-here-generate-a-random-hex-string

# Database Configuration (optional - defaults to SQLite)
# For SQLite (default): sqlite:///learn.db
# For PostgreSQL: postgresql://username:password@localhost/dbname
# For MySQL: mysql://username:password@localhost/dbname
DATABASE_URL=sqlite:///learn.db

# Security Configuration (optional)
SECURITY_TOKEN_MAX_AGE=86400
SECURITY_REGISTERABLE=true

# Email Configuration (REQUIRED for password reset/recovery)
# Example using Gmail:
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# Example using SMTP2GO:
# MAIL_SERVER=mail.smtp2go.com
# MAIL_PORT=2525
MAIL_SERVER=mail.smtp2go.com
MAIL_PORT=2525
MAIL_USE_TLS=true
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_DEFAULT_SENDER=noreply@yourdomain.com

# Admin User Configuration (optional)
# The email address for the auto-created admin/enumerator account
# Defaults to 'edwinlock@gmail.com' if not set
EDWIN_EMAIL=your-admin-email@example.com
